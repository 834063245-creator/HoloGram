{
  "productName": "全息观测站",
  "identifier": "com.hologram.hg",
  "version": "7.2.0",
  "build": {
    "frontendDist": "../src-ui/dist",
    "devUrl": "http://127.0.0.1:1420",
    "beforeDevCommand": "cd /d D:\\HoloGramHG\\src-ui && npm run dev",
    "beforeBuildCommand": "cd ../src-ui && npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "全息观测站",
        "width": 1000,
        "height": 700,
        "resizable": true,
        "center": true,
        "decorations": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "resources": ["../grammars/*.dll", "../grammars/aura.dll"],
    "windows": {
      "wix": {
        "language": "zh-CN",
        "fragmentPaths": ["wix/cleanup.wxs"]
      }
    }
  }
}