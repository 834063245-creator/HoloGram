{
  "productName": "兰台",
  "identifier": "com.lantai.app",
  "version": "1.0.6",
  "build": {
    "frontendDist": "../src-ui/dist",
    "devUrl": "http://127.0.0.1:1420",
    "beforeDevCommand": { "script": "cargo build -p hologram-engine && npm --prefix src-ui run dev", "cwd": ".." },
    "beforeBuildCommand": { "script": "npm --prefix src-ui run build && cargo build -p hologram-engine --release", "cwd": ".." }
  },
  "app": {
    "windows": [
      {
        "title": "兰台",
        "width": 1000,
        "height": 700,
        "minWidth": 880,
        "minHeight": 600,
        "resizable": true,
        "center": true,
        "decorations": false,
        "additionalBrowserArgs": "--remote-debugging-port=9222"
      }
    ]
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": {
      "../target/release/hologram-engine.exe": "hologram-engine.exe",
      "../target/release/hologram-lspd.exe": "hologram-lspd.exe",
      "../engine/grammars/*.dll": "grammars/",
      "../engine/onnxruntime.dll": "onnxruntime.dll",
      "../engine/models/all-MiniLM-L6-v2/model.onnx": "models/all-MiniLM-L6-v2/model.onnx",
      "../engine/models/all-MiniLM-L6-v2/vocab.txt": "models/all-MiniLM-L6-v2/vocab.txt",
      "bin/officecli.exe": "officecli.exe",
      "vendor": "vendor/",
      "../src-ui/dist-plugins": "_up_/src-ui/dist-plugins/"
    },
    "windows": {
      "nsis": {
        "languages": [
          "SimpChinese"
        ],
        "installerHooks": "nsis/installer-hooks.nsh"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDJERjAyQzgyM0E0REUyMjcKUldRbjRrMDZnaXp3TGZydWZVbzloa2xZNzdPQjBLbDM1Zlhldzk2K2dUVjMvMnUzZ3RhQ1VINXAK",
      "endpoints": [
        "https://github.com/834063245-creator/LantaiAgent/releases/latest/download/latest.json"
      ]
    }
  }
}
