{
  "productName": "全息观测站",
  "identifier": "com.hologram.hg",
  "version": "10.4.0",
  "build": {
    "frontendDist": "../src-ui/dist",
    "devUrl": "http://127.0.0.1:1420",
    "beforeDevCommand": "npm --prefix ../src-ui run dev",
    "beforeBuildCommand": "npm --prefix ../src-ui run build"
  },
  "app": {
    "windows": [
      {
        "title": "全息观测站",
        "width": 1000,
        "height": 700,
        "minWidth": 880,
        "minHeight": 600,
        "resizable": true,
        "center": true,
        "decorations": false,
        "additionalBrowserArgs": "--remote-debugging-port=9222"
      }
    ]
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": [
      "../grammars/*.dll",
      "onnxruntime.dll",
      "models/all-MiniLM-L6-v2/model.onnx",
      "models/all-MiniLM-L6-v2/vocab.txt",
      "vendor/**/*"
    ],
    "windows": {
      "wix": {
        "language": "zh-CN",
        "fragmentPaths": [
          "wix/cleanup.wxs"
        ]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEFFNEQ0NjAxMjNBMkQ1NTMKUldSVDFhSWpBVVpOcmxXc1ZBN3Q4c0pzbEtrb3dWckk4RUU5c1ozNlJ0d1ZvYTZlOWFSTmVqQ0QK",
      "endpoints": [
        "https://github.com/834063245-creator/HoloGram/releases/latest/download/latest.json"
      ]
    }
  }
}
