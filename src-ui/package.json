  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:mock": "vite",
    "build": "tsc --noEmit && cross-env NODE_OPTIONS=--max-old-space-size=4096 vite build",
    "format": "biome format --write .",
    "lint": "biome check --fix .",
    "check": "biome ci .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:convergence": "vitest run tests/convergence",
    "verify:convergence": "node tests/convergence/gate.mjs check",
    "record:convergence": "cross-env CONVERGENCE_RECORD=1 node tests/convergence/gate.mjs record",
    "report:convergence": "node tests/convergence/gate.mjs report"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.2.9",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/lxgw-wenkai": "^5.3.0",
    "@fontsource/noto-serif-sc": "^5.2.9",
    "@tanstack/react-virtual": "^3.14.8",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "@types/three": "^0.185.1",
    "gpt-tokenizer": "^3.4.0",
    "highlight.js": "^11.11.1",
    "monaco-editor": "^0.55.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "three": "^0.185.1",
    "zod": "^4.4.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@webgpu/types": "^0.1.70",
    "cross-env": "^10.1.0",
    "jsdom": "^29.1.1",
    "tsx": "^4.22.4",
    "typescript": "^6.0.0",
    "vite": "^6.0",
    "vitest": "^4.1.9"
  },
  "overrides": {
    "dompurify": "^3.4.13"
  }
}
