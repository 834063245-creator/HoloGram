;; C++ Structure Queries

(function_definition) @fn
(class_specifier) @class
(struct_specifier) @class
(union_specifier) @class
(enum_specifier) @class
(call_expression) @call
(preproc_include) @import

;; ── Variables ──
(declaration) @var

;; ── Writes ──
(assignment_expression) @write

;; ── Throws ──
(throw_statement) @throws

;; ── Usage ──
(identifier) @usage
